// Worker du serveur central : API et base D1 (voir docs/adr/0003).
{
  "name": "undergrounddeals-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Joignable uniquement par l'appli, via la liaison de service `API`.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "undergrounddeals",
      // Identifiant fictif : scripts/preparer-cloudflare.mjs y écrit le vrai au déploiement.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
